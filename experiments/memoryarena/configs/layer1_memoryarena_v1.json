{
  "dataset": {
    "name": "MemoryArena",
    "subset": "group_travel_planner",
    "row_selection": "fixed_seed_counterbalanced",
    "task_facts_mutable": false,
    "gold_answers_visible_to_agent": false
  },
  "runtime_plan": {
    "main_runtime": "Claude Code",
    "main_runtime_scope": "full_matrix",
    "codex_scope": "small_portability_replication",
    "openclaw_scope": "smoke_appendix_only"
  },
  "profiles": {
    "n_total": 8,
    "n_real_derived": 4,
    "n_fictional": 4,
    "profile_source_file": "memoryarena/profiles.py"
  },
  "conditions": [
    "no_memory",
    "compiled_enforcement",
    "trace_native_cc",
    "trace_native_codex"
  ],
  "phase_split": {
    "rows_per_user_condition": 4,
    "sessions_per_row": 6,
    "phase_a_sessions_per_row": 3,
    "phase_b_sessions_per_row": 3,
    "phase_a_sessions_per_user_condition": 12,
    "phase_a_min_usable_corrections": 3,
    "phase_a_max_sessions_per_user_condition": 16,
    "phase_b_sessions_per_user_condition": 12,
    "held_out_phase_b": true,
    "same_task_seeds_across_conditions": true,
    "counterbalance_order": true
  },
  "primary_metrics": [
    "avoidable_correction_rate",
    "objective_task_quality"
  ],
  "secondary_metrics": [
    "user_turns",
    "user_tokens",
    "clarification_questions",
    "repeated_corrections",
    "correction_free_success_rate",
    "retry_count",
    "rule_trigger_precision",
    "skill_provenance_coverage"
  ],
  "statistical_plan": {
    "primary_unit": "user_profile",
    "main_comparisons": [
      "compiled_enforcement_vs_no_memory",
      "trace_native_cc_vs_no_memory",
      "trace_native_codex_vs_no_memory",
      "trace_native_cc_vs_compiled_enforcement",
      "trace_native_codex_vs_compiled_enforcement"
    ],
    "report_confidence_intervals": true,
    "mixed_effects_auxiliary": true,
    "separate_real_derived_and_fictional": true
  }
}
